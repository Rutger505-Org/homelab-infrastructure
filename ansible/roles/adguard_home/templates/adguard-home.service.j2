[Unit]
Description=AdGuard Home
After=network-online.target
Wants=network-online.target

[Service]
User=adguardhome
Group=adguardhome
WorkingDirectory={{ adguard_home_dir }}
# Version is pinned by Ansible, so the built-in updater stays off.
ExecStart=/usr/local/bin/AdGuardHome \
  --config {{ adguard_home_dir }}/AdGuardHome.yaml \
  --work-dir {{ adguard_home_dir }} \
  --no-check-update
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ adguard_home_dir }}

[Install]
WantedBy=multi-user.target
