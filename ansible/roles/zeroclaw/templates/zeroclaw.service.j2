[Unit]
Description=ZeroClaw daemon (gateway, dashboard, channels, cron)
After=network-online.target
Wants=network-online.target

[Service]
User={{ zeroclaw_user }}
WorkingDirectory={{ zeroclaw_home }}
Environment=HOME={{ zeroclaw_home }}
# Local-only gog keyring password; never store its value in this repository.
EnvironmentFile=-{{ zeroclaw_home }}/.config/gogcli/keyring.env
# Lets agent shells use the user manager (systemctl/systemd-run --user), e.g.
# the Fastify emulator script. Lingering keeps it running.
Environment=XDG_RUNTIME_DIR=/run/user/{{ zeroclaw_uid }}
# Env overrides of ~/.zeroclaw/config.toml, never written to it: the dashboard
# owns that file. Binding beyond localhost needs allow_public_bind.
Environment=ZEROCLAW_gateway__host=0.0.0.0
Environment=ZEROCLAW_gateway__port={{ zeroclaw_gateway_port }}
Environment=ZEROCLAW_gateway__allow_public_bind=true
Environment=ZEROCLAW_gateway__trust_forwarded_headers=true
# Behind Caddy every request is remote, so the dashboard's reload button needs
# this. Still requires a paired token (require_pairing stays on).
Environment=ZEROCLAW_gateway__allow_remote_admin=true
ExecStart=/opt/zeroclaw/{{ zeroclaw_version }}/zeroclaw daemon
Restart=always
RestartSec=3
# Agent shells (cargo, gradle) run in this cgroup. Default OOMPolicy=stop takes
# the whole daemon and every running turn down when the kernel kills one build.
OOMPolicy=continue
# Stop: SIGTERM to the daemon only; once it exits, whatever its agent shells
# still run gets SIGKILL right away. With control-group they got SIGTERM too
# and one ignoring it held the stop until the timeout.
KillMode=mixed
# The daemon stops in milliseconds (zeroclaw-patches 0002); this only caps a
# hang, default 90 s.
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
