[Unit]
Description=ZeroClaw daemon (gateway, dashboard, channels, cron)
After=network-online.target
Wants=network-online.target

[Service]
User={{ zeroclaw_user }}
WorkingDirectory={{ zeroclaw_home }}
Environment=HOME={{ zeroclaw_home }}
# Env overrides of ~/.zeroclaw/config.toml, never written to it: the dashboard
# owns that file. Binding beyond localhost needs allow_public_bind.
Environment=ZEROCLAW_gateway__host=0.0.0.0
Environment=ZEROCLAW_gateway__port={{ zeroclaw_gateway_port }}
Environment=ZEROCLAW_gateway__allow_public_bind=true
Environment=ZEROCLAW_gateway__trust_forwarded_headers=true
ExecStart=/opt/zeroclaw/{{ zeroclaw_version }}/zeroclaw daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
