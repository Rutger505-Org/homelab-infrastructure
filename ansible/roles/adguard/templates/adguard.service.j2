[Unit]
Description=AdGuard Home
After=network-online.target
Wants=network-online.target

[Service]
User=adguard
Group=adguard
WorkingDirectory={{ adguard_dir }}
# Version is pinned by Ansible, so the built-in updater stays off.
ExecStart=/usr/local/bin/AdGuardHome \
  --config {{ adguard_dir }}/AdGuardHome.yaml \
  --work-dir {{ adguard_dir }} \
  --no-check-update
Restart=on-failure
RestartSec=5
# CAP_NET_RAW: the DHCP server answers clients that have no address yet.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ adguard_dir }}

[Install]
WantedBy=multi-user.target
