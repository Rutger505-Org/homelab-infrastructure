#!/usr/sbin/nft -f
# Only this table is replaced, never the whole ruleset.
table inet host_firewall
delete table inet host_firewall

table inet host_firewall {
  chain input {
    type filter hook input priority filter; policy drop;

    ct state established,related accept
    ct state invalid drop
    iif "lo" accept
    meta l4proto { icmp, ipv6-icmp } accept

    tcp dport 22 accept
    tcp dport {{ seaweedfs_s3_port }} accept
    # node exporter (role node_exporter), scraped by Prometheus in k3s; pod
    # traffic is masqueraded to the node IP
    ip saddr { {{ (groups['k3s_server'] + groups['k3s_agent']) | map('extract', hostvars, 'ansible_host') | join(', ') }} } tcp dport 9100 accept
  }
}
