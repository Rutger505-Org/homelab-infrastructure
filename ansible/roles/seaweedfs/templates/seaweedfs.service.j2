[Unit]
Description=SeaweedFS (master, volume, filer and S3 gateway)
After=network-online.target
Wants=network-online.target

[Service]
User=seaweedfs
Group=seaweedfs
WorkingDirectory={{ seaweedfs_data_dir }}
# Master, volume and filer only listen on localhost; the S3 gateway is the one
# thing exposed, and the Iceberg and Lance endpoints are disabled.
ExecStart=/usr/local/bin/weed server \
  -dir={{ seaweedfs_data_dir }} \
  -ip=127.0.0.1 \
  -ip.bind=127.0.0.1 \
  -master.volumeSizeLimitMB={{ seaweedfs_volume_size_limit_mb }} \
  -volume.max=0 \
  -filer \
  -filer.disableDirListing \
  -s3 \
  -s3.port={{ seaweedfs_s3_port }} \
  -s3.ip.bind=0.0.0.0 \
  -s3.port.iceberg=0 \
  -s3.port.lance=0 \
  -s3.config=/etc/seaweedfs/s3.json
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ seaweedfs_data_dir }}

[Install]
WantedBy=multi-user.target
